# ==============================================================================
# Đề tài 9: Xây dựng hệ thống xử lý ảnh hướng sự kiện bằng Serverless
# Thành viên: Lê Doãn Đạt (038206000230) - Kiến trúc sư Hạ tầng & DevOps
# File: .env.example
# ==============================================================================
# NGUYÊN TẮC BẢO MẬT:
# 1. TUYỆT ĐỐI KHÔNG commit tệp .env thật chứa khóa bí mật lên Git.
# 2. Khi chạy trên AWS Lambda, các biến môi trường bên dưới được Terraform tự động
#    tiêm (inject) vào hàm thông qua khối `environment` trong `terraform/lambda.tf`.
#    Xác thực AWS sử dụng IAM Execution Role (STS Temporary Credentials) tự động.
# 3. Khi chạy script kiểm thử ở máy local (LocalStack), sao chép tệp này:
#    cp .env.example .env
# ==============================================================================

# Môi trường vận hành (local | dev | staging | prod)
ENVIRONMENT=local
AWS_DEFAULT_REGION=ap-southeast-1

# Endpoint dùng cho môi trường giả lập LocalStack (Để trống nếu chạy trên AWS thật)
LOCALSTACK_ENDPOINT=http://localhost:4566

# Định danh tài nguyên Hạ tầng (Khớp với kết quả xuất từ `terraform output`)
INPUT_BUCKET=dtdm-image-processor-input-local
OUTPUT_BUCKET=dtdm-image-processor-output-local
METADATA_TABLE=dtdm-image-processor-metadata-local
DLQ_URL=http://localhost:4566/000000000000/dtdm-image-processor-dlq-local

# Cấu hình Xử lý ảnh & Retry
MAX_RETRY_COUNT=3
THUMBNAIL_WIDTH=200
THUMBNAIL_HEIGHT=200
LOG_LEVEL=INFO
